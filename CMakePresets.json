{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc"
    },
    {
      "name": "msvc-ninja",
      "displayName": "MSVC x64 (Ninja, any Visual Studio version; run from a developer prompt)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/msvc-ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw",
      "displayName": "MinGW-w64 (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "msvc-ninja-debug", "configurePreset": "msvc-ninja", "configuration": "Debug" },
    { "name": "msvc-ninja-release", "configurePreset": "msvc-ninja", "configuration": "Release" },
    { "name": "mingw", "configurePreset": "mingw" }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-ninja-debug",
      "configurePreset": "msvc-ninja",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-ninja-release",
      "configurePreset": "msvc-ninja",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "mingw",
      "configurePreset": "mingw",
      "output": { "outputOnFailure": true }
    }
  ]
}
